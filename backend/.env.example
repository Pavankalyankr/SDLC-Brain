# =============================================================================
# SDLC Brain — Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# --- Application ---
APP_NAME=SDLC Brain
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# --- Server ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# --- Database ---
DATABASE_URL=postgresql+asyncpg://sdlcbrain:sdlcbrain@localhost:5432/sdlcbrain

# --- AI Configuration ---
# Gemini (Default Provider)
GEMINI_API_KEY=your-gemini-key-here

# Default Models
DEFAULT_REASONING_MODEL=gemini-2.5-flash
DEFAULT_CODING_MODEL=gemini-2.5-flash

# AI Configuration File Path
AI_CONFIG_PATH=ai_config.yaml

# --- Workspace ---
WORKSPACE_ROOT=./workspace
UPLOAD_MAX_SIZE_MB=50

# --- Logging ---
LOG_LEVEL=INFO
