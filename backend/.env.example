# =============================================================================
# SDLC Brain — Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# --- Application ---
APP_NAME=SDLC Brain
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# --- Server ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# --- Database ---
DATABASE_URL=postgresql+asyncpg://sdlcbrain:sdlcbrain@localhost:5432/sdlcbrain

# --- AI Configuration ---
# OpenRouter (Default Provider)
OPENROUTER_API_KEY=your-openrouter-key-here
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Default Models
DEFAULT_REASONING_MODEL=openrouter/deepseek/deepseek-r1
DEFAULT_CODING_MODEL=openrouter/qwen/qwen-3-coder-instruct

# AI Configuration File Path
AI_CONFIG_PATH=ai_config.yaml

# --- Workspace ---
WORKSPACE_ROOT=./workspace
UPLOAD_MAX_SIZE_MB=50

# --- Logging ---
LOG_LEVEL=INFO
